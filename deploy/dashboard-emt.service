# /etc/systemd/system/dashboard-emt.service
#
# Instalación (en la Radxa):
#   sudo useradd --system --home /opt/dashboard-emt --shell /usr/sbin/nologin emt
#   sudo mkdir -p /opt/dashboard-emt && sudo cp -r server/* /opt/dashboard-emt/
#   sudo python3 -m venv /opt/dashboard-emt/.venv
#   sudo /opt/dashboard-emt/.venv/bin/pip install -r server/requirements.txt -r server/requirements-voz.txt
#   sudo chown -R root:root /opt/dashboard-emt     # el servicio no puede modificar su código
#   sudo cp dashboard-emt.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dashboard-emt
#   systemd-analyze security dashboard-emt          # puntuación de aislamiento

[Unit]
Description=Dashboard EMT Valencia (proxy + avisos)
After=network-online.target
Wants=network-online.target

[Service]
User=emt
Group=emt
WorkingDirectory=/opt/dashboard-emt
ExecStart=/opt/dashboard-emt/.venv/bin/python app.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

# --- Aislamiento ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
MemoryMax=600M

[Install]
WantedBy=multi-user.target
